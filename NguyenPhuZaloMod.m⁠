    BOOL hideTypingStatus;     // 2. Ẩn Đang soạn tin
    BOOL hideOnlineStatus;     // 3. Ẩn Trạng thái Online
    BOOL preventMsgRecall;     // 4. Chống Thu hồi tin nhắn
    BOOL downloadHDStories;    // 5. Tải Story HD
    BOOL downloadViewOnce;     // 6. Lưu ảnh/video Xem 1 lần
    BOOL disableAds;           // 7. Chặn Quảng cáo
    BOOL unlockVIPBadges;      // 8. Khung Profile VIP
    BOOL bypassScreenshot;     // 9. Bỏ chặn Chụp màn hình
    BOOL autoLikeStories;      // 10. Auto Like Story
    BOOL customThemeDark;      // 11. Giao diện Dark Amoled
    BOOL fastForwardAudio;     // 12. Tua nhanh Voice x2
    BOOL allowLargeFiles;      // 13. Gửi File dung lượng lớn
    BOOL hideGroupMembers;     // 14. Ẩn Thành viên nhóm
    BOOL autoReplyMsg;         // 15. Tự động Trả lời
    BOOL pinUnlimitedChats;    // 16. Ghim vô hạn Chat
    BOOL lockAppBio;           // 17. Khóa ứng dụng (FaceID/Passcode)
    BOOL fakeLocation;         // 18. Giả lập Vị trí GPS
    BOOL customFontSize;       // 19. Tùy chỉnh Cỡ chữ
    BOOL customFontBold;       // 20. Font chữ In đậm
    BOOL customFontItalic;     // 21. Font chữ In nghiêng
